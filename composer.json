{
    "name": "oblio/oblio-fgwoo",
    "description": "Oblio Invoicing. Native Oblio.eu integration with queues and stock sync.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OblioWoo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OblioWoo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "make-pot": "wp i18n make-pot . languages/oblio-fgwoo.pot --slug=oblio-fgwoo --exclude=tests,vendor,node_modules"
    }
}
